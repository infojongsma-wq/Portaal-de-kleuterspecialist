# Kopieer dit bestand naar .env.local en vul de waarden in.
#
# Zolang deze variabelen leeg zijn draait het portaal op de ingebouwde
# demogegevens (verzonnen scholen en personen). Zodra ze gevuld zijn schakelt
# de datalaag over op Supabase.

# Projectgegevens van de Supabase-omgeving (regio EU Frankfurt).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LET OP: uitsluitend serverside. Nooit in een NEXT_PUBLIC_*-variabele en
# nooit in clientcode gebruiken (zie CLAUDE.md en SPEC.md hoofdstuk 7).
SUPABASE_SERVICE_ROLE_KEY=
