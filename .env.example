# Kopieer dit bestand naar .env.local en vul de waarden in.
#
# In Supabase: Project Settings → Data API voor de URL, en → API Keys voor de
# sleutels. Supabase is de sleutels aan het hernoemen; je ziet "anon public" of
# "Publishable key" voor de eerste, en "service_role" of "Secret key" voor de
# tweede.

# Project URL, zonder pad erachter. Dus wél https://xxx.supabase.co
# en niet https://xxx.supabase.co/rest/v1/
NEXT_PUBLIC_SUPABASE_URL=

# De publieke sleutel. Deze komt in de browser terecht en is bedoeld om
# openbaar te zijn; Row Level Security in Postgres doet het beveiligingswerk.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LET OP: uitsluitend serverside. Deze sleutel gaat langs alle
# beveiligingsregels heen. Nooit in een NEXT_PUBLIC_*-variabele, nooit in
# clientcode, nooit in een chat of e-mail (zie CLAUDE.md en SPEC.md hoofdstuk 7).
SUPABASE_SERVICE_ROLE_KEY=
